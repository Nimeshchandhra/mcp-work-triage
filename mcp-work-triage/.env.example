# Least-Privilege GitHub Configuration
# READ TOKEN: Scoped strictly to read-only access (public_repo or issues:read)
GITHUB_READ_TOKEN=ghp_read_only_placeholder_token

# WRITE TOKEN: Optional scoped token for applying approved triage labels/comments
# DISABLED by default for zero autonomous write capability
GITHUB_WRITE_TOKEN=ghp_scoped_write_placeholder_token

# Master switch: Writes are physically forbidden unless explicitly set to 'true'
ENABLE_WRITE_OPERATIONS=false

# Local storage configuration
STAGING_DB_PATH=drafts.db
AUDIT_LOG_PATH=audit_log.jsonl

# Resilience & timeout configuration
REQUEST_TIMEOUT_CONNECT=5.0
REQUEST_TIMEOUT_READ=15.0
MAX_RETRIES=3
MAX_PAGES=10
STRIP_PRIVATE_MARKERS=true
